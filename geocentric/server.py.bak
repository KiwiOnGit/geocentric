    @app.get("/api/device-context")
    def get_device_context(request: Request) -> Dict[str, Any]:
        import platform
        import socket
        import psutil

        client_ip = request.client.host if request.client else "127.0.0.1"

        # Determine all local server IPs
        local_ips = ["127.0.0.1", "localhost"]
        try:
            hostname = socket.gethostname()
            for info in socket.getaddrinfo(hostname, None):
                ip = info[4][0]
                if ip not in local_ips:
                    local_ips.append(ip)
        except Exception:
            pass

        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            lan_ip = s.getsockname()[0]
            if lan_ip not in local_ips:
                local_ips.append(lan_ip)
            s.close()
        except Exception:
            pass

        is_local = (client_ip in local_ips) or (client_ip == "testclient")

        # Get system statistics
        try:
            cpu_percent = psutil.cpu_percent()
            memory_percent = psutil.virtual_memory().percent
        except Exception:
            cpu_percent = 0.0
            memory_percent = 0.0

        return {
            "client_ip": client_ip,
            "is_local_device": is_local,
            "local_ips": [ip for ip in local_ips if ":" not in ip], # Filter IPv6 for simplicity
            "system": {
                "device": str(device),
                "dtype": str(dtype),
                "platform": platform.system(),
                "cpu_percent": cpu_percent,
                "memory_percent": memory_percent,
            }
        }

    @app.get("/api/generate-image/stream")
    @app.post("/api/generate-image/stream")
    async def stream_generate_image_endpoint(
        prompt: str,
        chat_id: str,
        steps: int = 4,
        width: int = 512,
        height: int = 512,
        style: str = "fast",
        quality: str = "standard",
        request: Request = None
    ):
        user = get_user_from_request(request)
        if not user:
            raise HTTPException(status_code=401, detail="Unauthorized")
        limits = check_user_limits(str(user["id"]))
        if user_is_out_of_usage(limits) and not int(limits.get("infinite_usage") or 0):
            async def limited_generator():
                reset_in = max(0, int(float(limits.get("limited_until") or (time.time() + 3600)) - time.time()))
                yield f"data: {json.dumps({'status': 'limited', 'error': 'Usage limit reached', 'reset_in_seconds': reset_in})}\n\n"
                yield "data: [DONE]\n\n"
            return StreamingResponse(limited_generator(), media_type="text/event-stream")

        def progress_generator():
            try:
                import queue
                import threading
                from geocentric.image_generator import generate_image_local, resolve_image_options

                progress_queue = queue.Queue()
                resolved_style, resolved_quality, style_cfg, quality_cfg = resolve_image_options(style, quality)
                resolved_steps = int(quality_cfg.get("steps") or steps)
                model_id = str(style_cfg.get("model_id") or "stabilityai/sd-turbo")

                def callback(step, total):
                    progress_queue.put({"status": "generating", "progress": int((step / total) * 100), "step": step, "total_steps": total})

                def run_generation():
                    try:
                        progress_queue.put({"status": "loading", "progress": 0})
                        img = generate_image_local(
                            prompt=prompt,
                            num_inference_steps=resolved_steps,
                            width=width,
                            height=height,
                            callback=callback,
                            model_id=model_id,
                            style=resolved_style
                        )
                        # Save the generated image to workspace
                        workspace_dir = workspace_dir_for(user["id"], chat_id)
                        generated_dir = workspace_dir / "generated"
                        generated_dir.mkdir(parents=True, exist_ok=True)
                        filename = f"generated-{int(time.time())}.png"
                        target_path = generated_dir / filename
                        img.save(target_path)
                        record_image_usage(str(user["id"]))
                        
                        rel_path = target_path.relative_to(workspace_dir).as_posix()
                        url = f"/api/download/{urllib.parse.quote(chat_id)}/{urllib.parse.quote(rel_path)}"
                        
                        explanation = generate_image_description(prompt)
                        progress_queue.put({"status": "completed", "progress": 100, "url": url, "filename": filename, "style": resolved_style, "quality": resolved_quality, "explanation": explanation})
                    except Exception as exc:
                        progress_queue.put({"status": "error", "error": str(exc)})

                thread = threading.Thread(target=run_generation, daemon=True)
                thread.start()

                # Poll the queue and yield updates
                while thread.is_alive() or not progress_queue.empty():
                    try:
                        msg = progress_queue.get_nowait()
                        yield f"data: {json.dumps(msg)}\n\n"
                    except queue.Empty:
                        time.sleep(0.1)

            except Exception as e:
                yield f"data: {json.dumps({'status': 'error', 'error': str(e)})}\n\n"
            finally:
                yield "data: [DONE]\n\n"

        return StreamingResponse(progress_generator(), media_type="text/event-stream")


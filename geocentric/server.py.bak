class LlamaServerManager:
    _instance = None
    _lock = threading.Lock()

    def __new__(cls, *args, **kwargs):
        with cls._lock:
            if cls._instance is None:
                cls._instance = super(LlamaServerManager, cls).__new__(cls)
                cls._instance.initialized = False
            return cls._instance

    def __init__(self):
        if self.initialized:
            return
        self.process = None
        self.current_model_path = None
        self.current_is_instant = None
        self.current_context_size = None
        self.port = 11435
        self.lock = threading.Lock()
        self.initialized = True

    def stop(self):
        with self.lock:
            self._stop_unlocked()

    def _stop_unlocked(self):
        if self.process:
            print(f"[LlamaServerManager] Stopping llama-server...")
            try:
                self.process.terminate()
                self.process.wait(timeout=5)
            except Exception as e:
                print(f"[LlamaServerManager] Error terminating: {e}")
                try:
                    self.process.kill()
                except Exception:
                    pass
            self.process = None
        self.current_model_path = None
        self.current_is_instant = None
        self.current_context_size = None

    def start(self, model_path: str, is_instant: bool, context_size: int = 8192):
        with self.lock:
            if self.process and self.process.poll() is None:
                if self.current_model_path == model_path and self.current_is_instant == is_instant and self.current_context_size == context_size:
                    return
                print(f"[LlamaServerManager] Config changed. Stopping old instance (model: {self.current_model_path}, instant: {self.current_is_instant}, context: {self.current_context_size})")
                self._stop_unlocked()

            self._kill_process_on_port(self.port)

            cmd = [
                "/Applications/Ollama.app/Contents/Resources/llama-server",
                "-m", model_path,
                "-ngl", "99",
                "--port", str(self.port),
                "-c", str(context_size)
            ]
            if is_instant:
                cmd.extend(["-rea", "off", "--reasoning-budget", "0"])
            else:
                cmd.extend(["-rea", "on", "--reasoning-budget", "-1"])

            print(f"[LlamaServerManager] Starting: {' '.join(cmd)}")
            try:
                self.process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True
                )
                self.current_model_path = model_path
                self.current_is_instant = is_instant
                self.current_context_size = context_size
                
                # Wait for port to open and verify
                start_time = time.time()
                success = False
                while time.time() - start_time < 30:
                    if self.process.poll() is not None:
                        stdout, stderr = self.process.communicate()
                        print(f"[LlamaServerManager] llama-server died immediately. stdout: {stdout}, stderr: {stderr}")
                        break
                    if self._is_port_open(self.port):
                        if self._verify_server_ready():
                            success = True
                            break
                    time.sleep(0.5)

                if not success:
                    print(f"[LlamaServerManager] Failed to start llama-server within 30 seconds.")
                    self._stop_unlocked()
                    raise RuntimeError("llama-server failed to start or respond")
                print(f"[LlamaServerManager] llama-server ready on port {self.port}.")
            except Exception as e:
                print(f"[LlamaServerManager] Error starting: {e}")
                self._stop_unlocked()
                raise

    def _is_port_open(self, port):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            return s.connect_ex(('127.0.0.1', port)) == 0

    def _verify_server_ready(self):
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{self.port}/health")
            with urllib.request.urlopen(req, timeout=1) as response:
                data = json.loads(response.read().decode())
                return data.get("status") in ("ok", "success") or "status" in data or response.status == 200
        except Exception:
            try:
                req = urllib.request.Request(f"http://127.0.0.1:{self.port}/v1/models")
                with urllib.request.urlopen(req, timeout=1) as response:
                    return response.status == 200
            except Exception:
                return False

    def _kill_process_on_port(self, port):
        system = platform.system()
        if system in ("Darwin", "Linux"):
            try:
                output = subprocess.check_output(["lsof", "-t", f"-i:{port}"]).decode().strip()
                if output:
                    for pid in output.split("\n"):
                        print(f"[LlamaServerManager] Killing stale process {pid} on port {port}")
                        subprocess.call(["kill", "-9", pid])
            except Exception:
                pass

llama_manager = LlamaServerManager()
atexit.register(llama_manager.stop)

def resolve_ollama_model_to_gguf(model_name: str) -> str:
    home = os.path.expanduser("~")
    manifest_root = os.path.join(home, ".ollama", "models", "manifests", "registry.ollama.ai")
    blobs_root = os.path.join(home, ".ollama", "models", "blobs")
    
    if ":" in model_name:
        model_part, tag = model_name.rsplit(":", 1)
    else:
        model_part = model_name
        tag = "latest"
        
    model_part = model_part.replace("registry.ollama.ai/", "")
    
    if "/" in model_part:
        rel_path = os.path.join(model_part, tag)
    else:
        rel_path = os.path.join("library", model_part, tag)
        
    manifest_path = os.path.join(manifest_root, rel_path)
    
    if not os.path.exists(manifest_path):
        # Case insensitive walk fallback
        print(f"[LlamaServerManager] Manifest not found at {manifest_path}. Walking manifests directory...")
        found_manifest_path = None
        target_suffix = rel_path.lower()
        if os.path.exists(manifest_root):
            for root, dirs, files in os.walk(manifest_root):
                for f in files:
                    full_p = os.path.join(root, f)
                    rel_p = os.path.relpath(full_p, manifest_root)
                    if rel_p.lower() == target_suffix or rel_p.lower().replace("\\", "/") == target_suffix:
                        found_manifest_path = full_p
                        break
                if found_manifest_path:
                    break
        if found_manifest_path:
            manifest_path = found_manifest_path

    if not os.path.exists(manifest_path):
        raise FileNotFoundError(f"Ollama manifest file not found for model '{model_name}'")
        
    with open(manifest_path, "r", encoding="utf-8") as f:
        manifest_data = json.load(f)
        
    layers = manifest_data.get("layers", [])
    model_layer = None
    for layer in layers:
        if layer.get("mediaType") == "application/vnd.ollama.image.model":
            model_layer = layer
            break
            
    if not model_layer:
        raise ValueError(f"No model layer found in manifest {manifest_path}")
        
    digest = model_layer.get("digest")
    if not digest or not digest.startswith("sha256:"):
        raise ValueError(f"Invalid or missing digest in model layer: {digest}")
        
    digest_val = digest.replace("sha256:", "sha256-")
    blob_path = os.path.join(blobs_root, digest_val)
    
    if not os.path.exists(blob_path):
        raise FileNotFoundError(f"Model blob file not found at {blob_path}")
        
    return blob_path

